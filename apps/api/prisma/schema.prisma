// Divzy database schema.
// Money: integer minor units (cents/yen/fils), max ±2_000_000_000 (fits INT4).
// Soft deletes: expenses/settlements/comments keep history via deletedAt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

model User {
  id                           String   @id @default(cuid())
  email                        String   @unique
  phone                        String?  @unique
  passwordHash                 String
  name                         String
  avatarColor                  String   @default("#2a78d6")
  avatarUrl                    String?
  defaultCurrency              String   @default("USD")
  emailNotifications           Boolean  @default(true)
  staleBalanceRemindersEnabled Boolean  @default(false)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  refreshTokens      RefreshToken[]
  pushTokens         PushToken[]
  notificationPreferences NotificationPreference[]
  groupMemberships   GroupMember[]
  createdGroups      Group[]            @relation("GroupCreator")
  expensesPaid       ExpensePayer[]
  expenseSplits      ExpenseSplit[]
  createdExpenses    Expense[]          @relation("ExpenseCreator")
  updatedExpenses    Expense[]          @relation("ExpenseUpdater")
  settlementsFrom    Settlement[]       @relation("SettlementFrom")
  settlementsTo      Settlement[]       @relation("SettlementTo")
  createdSettlements Settlement[]       @relation("SettlementCreator")
  comments           Comment[]
  activities         ActivityLog[]      @relation("ActivityActor")
  activityInbox      ActivityRecipient[]
  notifications      Notification[]
  friendshipsA       Friendship[]       @relation("FriendA")
  friendshipsB       Friendship[]       @relation("FriendB")
  recurringCreated   RecurringExpense[]
  manualExchangeRates ManualExchangeRate[]
  expenseRevisions   ExpenseRevision[]  @relation("ExpenseRevisionActor")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())

  @@index([userId])
}

// WI-041 (ADR-021, auth's slice). Mirrors packages/shared/src/constants.ts
// NOTIFICATION_CATEGORIES key set exactly — keep both in sync (DRB condition
// C2, same manual-sync contract as SettlementMethod <-> SETTLEMENT_METHOD_KEYS).
// EXPENSE_DUE / MONTHLY_SUMMARY / PRODUCT_NEWS are reserved slots, `available:
// false` in the shared constant — no trigger/content source exists yet.
enum NotificationCategory {
  EXPENSE_ADDED
  EXPENSE_EDITED
  EXPENSE_DELETED
  COMMENT
  PAYMENT_RECEIVED
  GROUP_INVITE
  EXPENSE_DUE
  MONTHLY_SUMMARY
  PRODUCT_NEWS
}

/// Per-(user, category) push/email toggle matrix (WI-041). Auth is the sole
/// writer; notifications-activity reads it read-only at send time (same
/// read-only-elsewhere pattern as emailNotifications/staleBalanceRemindersEnabled).
/// Lazy rows, zero backfill: an absent row resolves to "both channels on" in
/// application code (see routes/users.ts GET /users/me/notification-preferences).
model NotificationPreference {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     NotificationCategory
  pushEnabled  Boolean              @default(true)
  emailEnabled Boolean              @default(true)
  updatedAt    DateTime             @updatedAt

  @@unique([userId, category])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Social graph
// ---------------------------------------------------------------------------

/// Invariant: userAId < userBId (lexicographic) — one row per pair.
model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userA     User     @relation("FriendA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User     @relation("FriendB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userBId])
}

/// Per-user, regeneratable friend-add code (WI-040). Owned by social-groups.
/// `userId` is a bare scalar (NO @relation to User) to avoid forcing an
/// opposite-relation field onto the auth-owned User model — see ADR (WI-040).
/// Regenerating overwrites `code`, invalidating the old value. Orphaned rows
/// (user deleted) are self-defensive: resolution finds no live user -> 404.
model FriendCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Groups
// ---------------------------------------------------------------------------

enum GroupType {
  TRIP
  HOME
  COUPLE
  FRIENDS
  PROJECT
  FAMILY
  ROOMMATES
  WORK
  CLUB
  SPORTS_TEAM
  EVENT
  SCHOOL
  SUBSCRIPTION
  NIGHT_OUT
  CHARITY
  OTHER
}

enum MemberRole {
  ADMIN
  MEMBER
}

model Group {
  id            String    @id @default(cuid())
  name          String
  emoji         String    @default("🧾")
  type          GroupType @default(OTHER)
  currency      String    @default("USD")
  inviteCode    String    @unique
  simplifyDebts Boolean   @default(true)
  createdById   String
  createdBy     User      @relation("GroupCreator", fields: [createdById], references: [id])
  archivedAt    DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  members    GroupMember[]
  expenses   Expense[]
  settlements Settlement[]
  activities ActivityLog[]
  recurring  RecurringExpense[]
  whiteboard GroupWhiteboard?
}

model GroupMember {
  id       String     @id @default(cuid())
  groupId  String
  group    Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     MemberRole @default(MEMBER)
  joinedAt DateTime   @default(now())
  leftAt   DateTime?

  @@unique([groupId, userId])
  @@index([userId])
}

/// Single shared plain-text note per group (WI-087). Owned by social-groups.
/// `updatedById` is a bare scalar (NO @relation to User) to avoid forcing an
/// opposite-relation field onto the auth-owned User model — same pattern as
/// FriendCode.userId (WI-040). Lazy creation: no row exists until first edit.
model GroupWhiteboard {
  id          String   @id @default(cuid())
  groupId     String   @unique
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  body        String   @default("")
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@index([groupId])
}

// ---------------------------------------------------------------------------
// Expenses
// ---------------------------------------------------------------------------

enum SplitType {
  EQUAL
  EXACT
  PERCENT
  SHARES
  ADJUSTMENT
  ITEMIZED
}

enum ExpenseCategory {
  FOOD_DRINK
  GROCERIES
  TRANSPORT
  HOME
  RENT
  UTILITIES
  ENTERTAINMENT
  TRAVEL
  SHOPPING
  HEALTH
  EDUCATION
  GIFTS
  PETS
  SUBSCRIPTIONS
  GENERAL
  OTHER
}

model Expense {
  id                 String          @id @default(cuid())
  groupId            String?
  group              Group?          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  description        String
  amount             Int
  currency           String
  category           ExpenseCategory @default(GENERAL)
  date               DateTime
  splitType          SplitType
  notes              String?
  receiptUrl         String?
  createdById        String
  createdBy          User            @relation("ExpenseCreator", fields: [createdById], references: [id])
  updatedById        String?
  updatedBy          User?           @relation("ExpenseUpdater", fields: [updatedById], references: [id])
  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  deletedAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  payers    ExpensePayer[]
  splits    ExpenseSplit[]
  items     ExpenseItem[]
  comments  Comment[]
  revisions ExpenseRevision[]

  @@index([groupId, date(sort: Desc)])
  @@index([date(sort: Desc)])
  @@index([deletedAt])
}

model ExpensePayer {
  id        String  @id @default(cuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  amount    Int

  @@unique([expenseId, userId])
  @@index([userId])
}

model ExpenseSplit {
  id         String  @id @default(cuid())
  expenseId  String
  expense    Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId     String
  user       User    @relation(fields: [userId], references: [id])
  amount     Int
  shares     Int?
  percentBps Int?
  adjustment Int?

  @@unique([expenseId, userId])
  @@index([userId])
}

model ExpenseItem {
  id             String   @id @default(cuid())
  expenseId      String
  expense        Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  name           String
  amount         Int
  participantIds String[]
}

// ---------------------------------------------------------------------------
// Expense edit history (WI-017, top-level scalar fields only)
// ---------------------------------------------------------------------------

enum ExpenseRevisionKind {
  CREATED
  UPDATED
}

/// One row per edit event (not per changed field). `changes` is `[]` for
/// CREATED; for UPDATED it holds a denormalized before/after snapshot per
/// changed tracked field (ADR-015). Immutable — later edits never mutate an
/// earlier entry.
model ExpenseRevision {
  id        String              @id @default(cuid())
  expenseId String
  expense   Expense             @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User                @relation("ExpenseRevisionActor", fields: [actorId], references: [id])
  kind      ExpenseRevisionKind
  changes   Json                @default("[]")
  createdAt DateTime            @default(now())

  @@index([expenseId, createdAt])
}

// ---------------------------------------------------------------------------
// Settlements
// ---------------------------------------------------------------------------

enum SettlementMethod {
  CASH
  BANK_TRANSFER
  UPI
  PAYPAL
  VENMO
  OTHER
}

model Settlement {
  id          String           @id @default(cuid())
  groupId     String?
  group       Group?           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUserId  String
  fromUser    User             @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUserId    String
  toUser      User             @relation("SettlementTo", fields: [toUserId], references: [id])
  amount      Int
  currency    String
  method      SettlementMethod @default(OTHER)
  note        String?
  proofUrl    String?
  date        DateTime
  createdById String
  createdBy   User             @relation("SettlementCreator", fields: [createdById], references: [id])
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([groupId, date(sort: Desc)])
  @@index([fromUserId])
  @@index([toUserId])
}

// ---------------------------------------------------------------------------
// Comments
// ---------------------------------------------------------------------------

model Comment {
  id        String    @id @default(cuid())
  expenseId String
  expense   Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([expenseId, createdAt])
}

// ---------------------------------------------------------------------------
// Activity & notifications
// ---------------------------------------------------------------------------

enum ActivityType {
  EXPENSE_ADDED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  EXPENSE_RESTORED
  SETTLEMENT_ADDED
  SETTLEMENT_DELETED
  SETTLEMENT_RESTORED
  GROUP_CREATED
  GROUP_UPDATED
  MEMBER_JOINED
  MEMBER_LEFT
  MEMBER_REMOVED
  COMMENT_ADDED
  FRIEND_ADDED
  RECURRING_POSTED
}

model ActivityLog {
  id           String       @id @default(cuid())
  type         ActivityType
  actorId      String
  actor        User         @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)
  groupId      String?
  group        Group?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  expenseId    String?
  settlementId String?
  data         Json         @default("{}")
  createdAt    DateTime     @default(now())

  recipients ActivityRecipient[]

  @@index([groupId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

/// Fan-out on write: one row per user who should see the activity item.
model ActivityRecipient {
  id         String      @id @default(cuid())
  activityId String
  activity   ActivityLog @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@index([userId, activityId])
}

enum NotificationType {
  EXPENSE_ADDED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  SETTLEMENT_RECORDED
  COMMENT_ADDED
  MEMBER_JOINED
  ADDED_TO_GROUP
  FRIEND_ADDED
  RECURRING_POSTED
  BALANCE_REMINDER
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json             @default("{}")
  readAt    DateTime?
  /// WI-056: "clear" removes a notification from the visible list, independent
  /// of readAt. Additive, nullable, no backfill. No dedicated index — the
  /// existing [userId, createdAt desc] index serves the default list query and
  /// clearedAt is a cheap residual predicate at per-user notification volumes.
  clearedAt DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
}

// ---------------------------------------------------------------------------
// Stale-balance reminders (settlements-owned, WI-016 / ADR-018)
// ---------------------------------------------------------------------------

/// Per-(user, counterparty, currency) cooldown bookkeeping for the daily
/// stale-balance reminder scan (apps/api/src/jobs/stale-balance-reminders.ts).
/// Additive, no backfill — see ADR-018.
model StaleBalanceReminder {
  id             String   @id @default(cuid())
  userId         String
  counterpartyId String
  currency       String
  lastRemindedAt DateTime

  @@unique([userId, counterpartyId, currency])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Recurring expenses
// ---------------------------------------------------------------------------

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

model RecurringExpense {
  id           String              @id @default(cuid())
  groupId      String?
  group        Group?              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  description  String
  amount       Int
  currency     String
  category     ExpenseCategory     @default(GENERAL)
  splitType    SplitType
  /// Array of { userId, amount } — validated against zExpensePayerInput.
  payers       Json
  /// Array of { userId, amount?, percentBps?, shares?, adjustment? }.
  participants Json
  notes        String?
  frequency    RecurrenceFrequency
  nextRunAt    DateTime
  endDate      DateTime?
  lastRunAt    DateTime?
  active       Boolean             @default(true)
  createdById  String
  createdBy    User                @relation(fields: [createdById], references: [id])
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  expenses Expense[]

  @@index([active, nextRunAt])
}

// ---------------------------------------------------------------------------
// FX cache
// ---------------------------------------------------------------------------

model ExchangeRateCache {
  id        String   @id @default(cuid())
  base      String   @unique
  rates     Json
  fetchedAt DateTime
}

/// Frozen daily copy of the live FX rates map, one row per (base currency, UTC day).
/// Written best-effort by getRates() on a successful live fetch (first fetch of the UTC
/// day wins; same-day repeats are no-ops). Snapshot-forward only — no historical backfill
/// (WI-014, ADR-012). Read by the rate-as-of-date resolver; never overwritten for a past day,
/// which is what makes an as-of conversion stable across calendar days.
model ExchangeRateSnapshot {
  id         String   @id @default(cuid())
  base       String // uppercase base currency, mirrors ExchangeRateCache.base
  date       DateTime @db.Date // UTC calendar day this snapshot represents
  rates      Json // major-unit rates keyed on uppercase codes (same shape as ExchangeRateCache.rates)
  capturedAt DateTime @default(now())

  @@unique([base, date])
  @@index([base, date])
}

/// Per-user manual FX rate, consulted only when the automatic chain
/// (ExchangeRateCache live/cache/fallback) throws RATE_UNAVAILABLE for a pair.
/// Automatic always takes precedence once available (ADR-006); never deleted
/// once superseded — it just goes unconsulted.
model ManualExchangeRate {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromCurrency String
  toCurrency   String
  rate         Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, fromCurrency, toCurrency])
  @@index([userId])
}
