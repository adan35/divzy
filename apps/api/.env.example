# ---------------------------------------------------------------------------
# Divzy API environment. Copy to .env and fill in.
#   cp apps/api/.env.example apps/api/.env
# ---------------------------------------------------------------------------

# Postgres connection. Matches docker-compose defaults (port 5433 on host).
DATABASE_URL=postgresql://divzy:divzy_dev_password@localhost:5433/divzy

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Pretty, verbose (debug-level) console logging — for local dev only.
# Deliberately NOT tied to NODE_ENV: a deployment that forgets to flip this
# stays on lean, production-safe JSON info-level logging by default instead
# of silently paying the synchronous pino-pretty debug-logging tax.
LOG_PRETTY=true

# Comma-separated origins allowed by CORS (web app + Expo dev origins).
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Public URL of the web app (used in emails / invite links).
WEB_URL=http://localhost:3000

# --- Secrets: generate with `openssl rand -hex 32` (use DIFFERENT values) ---
JWT_ACCESS_SECRET=change-me-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-openssl-rand-hex-32-different
COOKIE_SECRET=change-me-openssl-rand-hex-32-another

# Token lifetimes
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Receipt uploads (stored on local disk; swap for S3 in production)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# --- Optional: SMTP for email notifications (docker-compose ships Mailpit:
#     host=localhost port=1026, view mail at http://localhost:8026) ---
SMTP_HOST=
SMTP_PORT=1026
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Divzy <no-reply@divzy.app>"

# --- Optional: live FX rates. Free endpoint, no key needed. Leave as-is. ---
# Falls back to bundled static rates when unreachable.
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest

# --- Optional: Expo push notifications (no key needed for Expo's push service;
#     set to false to disable) ---
EXPO_PUSH_ENABLED=true
