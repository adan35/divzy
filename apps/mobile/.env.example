# Copy to .env. For a physical device, replace localhost with your machine's
# LAN IP (e.g. http://192.168.1.20:4000) so the phone can reach the API.
EXPO_PUBLIC_API_URL=http://localhost:4000
# Web app origin — used to build shareable links (settle-up link/QR).
EXPO_PUBLIC_WEB_URL=http://localhost:3000
